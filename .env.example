# Brand + domain (configurable; nothing is hardcoded in components)
NEXT_PUBLIC_SITE_NAME="Top Selling Jerseys"
NEXT_PUBLIC_SITE_URL="https://topsellingjerseys.net"
NEXT_PUBLIC_CONTACT_EMAIL="hello@topsellingjerseys.net"

# Affiliate tracking (server-only; appended when /out/ links redirect). Leave empty until approved by the network.
# Example for an Impact-style program: "irgwc=1&clickid={clickId}" — use exactly what the network gives you.
# Lids is the default shop. Paste the Impact tracking link with the destination replaced by {url},
# e.g. https://lids.example.sjv.io/c/111/222/333?u={url}  (use the real link Impact gives you)
AFFILIATE_DEEPLINK_LIDS=""
AFFILIATE_PARAMS_LIDS=""
# Lids Canada (lids.ca), used only for Canada promo codes. Same format as the Lids pair above.
AFFILIATE_DEEPLINK_LIDSCA=""
AFFILIATE_PARAMS_LIDSCA=""
AFFILIATE_PARAMS_FANATICS=""

# Editor desk click counts (optional). Every /out/ shopping click is counted on the desk.
# DESK_CLICK_URL is the desk's address (set it in Netlify, not here); DESK_CLICK_KEY must match CLICK_INGEST_KEY in the desk project.
DESK_CLICK_URL=""
DESK_CLICK_KEY=""

# Analytics (optional). Events always go to window.dataLayer; set an endpoint to also POST them.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=""
# Google Analytics 4 and Microsoft Clarity (components/Tags.tsx). Defaults are this site's own IDs; set to override.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-G3NLPZMT2W"
NEXT_PUBLIC_CLARITY_ID="z0yme16q8j"
# Impact.com Universal Tracking Tag (affiliate link tracking)
NEXT_PUBLIC_IMPACT_UTT_URL="https://utt.impactcdn.com/P-A6755530-4683-4d86-b572-0acec2e998581.js"
# Set to "true" to turn both tags off (for example on a staging copy).
NEXT_PUBLIC_DISABLE_TAGS=""
# "true" shows a consent banner and holds analytics until the visitor accepts.
NEXT_PUBLIC_REQUIRE_CONSENT="true"

# Price-drop alert signups POST {email, playerId} here (your newsletter or form service). The signup form stays hidden until set.
NEXT_PUBLIC_ALERTS_ENDPOINT=""

# Supabase project for accounts (saved My Jerseys lists) and newsletter sign-ups. Both stay hidden until set.
# Project Settings > API: Project URL and the anon / publishable key (public by design; supabase/schema.sql locks it down).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Search Console verification token (meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Daily Lids deals in the top bar (scripts/fetch-lids-deals.ts) and Lids jersey photos on player pages
# (scripts/sync-impact-products.ts); both run every morning in .github/workflows/daily-lids-deals.yml.
# Impact: Settings > API > Account SID and Auth Token. Campaign id defaults to the one in AFFILIATE_DEEPLINK_LIDS.
IMPACT_ACCOUNT_SID=""
IMPACT_AUTH_TOKEN=""
IMPACT_LIDS_CAMPAIGN_ID=""
# Lids catalog the jersey photo sync reads (Lids Main Feed is 5267, the default).
IMPACT_LIDS_CATALOG_ID=""
# Turns on /api/impact-diagnostic/ (a 5-item read of Lids catalog 5267). Any long random string; leave empty to keep the route off.
IMPACT_DIAGNOSTIC_KEY=""

# Newsletter. Sign-ups from the sidebar and footer go straight to the newsletter service, and the Weekly newsletter
# workflow sends each Thursday's issue through it. Server-only: never NEXT_PUBLIC_. The sign-up boxes stay hidden until
# the chosen service's settings are set. See docs/newsletter.md. Set them in Netlify (sign-ups) and as GitHub
# repository secrets (the weekly send).
NEWSLETTER_PROVIDER="kit"
# beehiiv: Settings > Workspace settings > API. Sending through the API needs beehiiv Pro (sign-ups work on the free plan).
BEEHIIV_API_KEY=""
BEEHIIV_PUBLICATION_ID=""
# Kit (kit.com): Settings > Developer > API keys, and the number in the form's address. Sending is free on Kit.
KIT_API_KEY=""
KIT_FORM_ID=""
# Optional: a Kit tag id added to every site sign-up.
KIT_TAG_ID=""
