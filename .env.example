# Brand + domain (configurable; nothing is hardcoded in components)
NEXT_PUBLIC_SITE_NAME="Top Selling Jerseys"
NEXT_PUBLIC_SITE_URL="https://topsellingjerseys.net"
NEXT_PUBLIC_CONTACT_EMAIL="hello@topsellingjerseys.net"

# Affiliate tracking (server-only; appended when /out/ links redirect). Leave empty until approved by the network.
# Example for an Impact-style program: "irgwc=1&clickid={clickId}" — use exactly what the network gives you.
AFFILIATE_PARAMS_FANATICS=""

# Analytics (optional). Events always go to window.dataLayer; set an endpoint to also POST them.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=""
# Google Analytics 4 and Microsoft Clarity (components/Tags.tsx). Defaults are this site's own IDs; set to override.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-G3NLPZMT2W"
NEXT_PUBLIC_CLARITY_ID="z0yme16q8j"
# Set to "true" to turn both tags off (for example on a staging copy).
NEXT_PUBLIC_DISABLE_TAGS=""
# "true" shows a consent banner and holds analytics until the visitor accepts.
NEXT_PUBLIC_REQUIRE_CONSENT="true"

# Price-drop alert signups POST {email, playerId} here (your newsletter or form service). The signup form stays hidden until set.
NEXT_PUBLIC_ALERTS_ENDPOINT=""

# Supabase project for accounts (saved My Jerseys lists) and newsletter sign-ups. Both stay hidden until set.
# Project Settings > API: Project URL and the anon / publishable key (public by design; supabase/schema.sql locks it down).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Search Console verification token (meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
